# Public front door: reverse proxy + (with a domain) automatic HTTPS.
{$SITE_ADDRESS::80} {
	# the SI agent's Chrome (noVNC)
	handle_path /browser/* {
		reverse_proxy agent:6080
	}
	handle {
		reverse_proxy psc:5000 {
			# model runs are long; do not cut the connection
			transport http {
				response_header_timeout 10m
			}
		}
	}
}
